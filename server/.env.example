APP_ID=your-app-id
APP_SECRET=your-app-secret
SIGNING_KEY=your-hex-encoded-signing-key
APP_STORE_URL=https://app-store-api.channel.io
PORT=3000

# Local debugging only. Never enable this in production.
SKIP_SIGNATURE_VERIFICATION=false

# Gmail OAuth. Redirect URI must match Google Cloud Console exactly.
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:8787/api/mail/oauth/gmail/callback
